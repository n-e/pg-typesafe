{
  "name": "pg-typesafe",
  "version": "0.0.1",
  "description": "Strongly typed queries for PostgreSQL and TypeScript",
  "license": "GPL-3.0-only",
  "author": "Nicolas Even <nicolas@even.li>",
  "homepage": "https://github.com/n-e/pg-typesafe",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n-e/pg-typesafe.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "bin": {
    "pg-typesafe": "dist/cli.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "npm run check && npm run test -- --no-watch && npm run build",
    "test": "vitest",
    "check": "tsc"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "@types/pg": "^8.16.0",
    "publint": "^0.3.17",
    "tsdown": "0.20.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "pg": "^8.18.0",
    "pg-protocol": "^1.11.0",
    "ts-morph": "^27.0.2"
  }
}
